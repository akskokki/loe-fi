{
  "name": "lofi",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "peer": "tsx src/app/peer.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "ui": "tsx src/app/ui/main.tsx",
    "harness": "tsx src/tools/harness.ts",
    "lint": "biome check src",
    "format": "biome format --write src"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "node-web-audio-api": "^2.3.0",
    "react": "^19.3.1"
  }
}
